# ── App ──────────────────────────────────────────────────────────────
APP_NAME="Sales Management Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# APP_DEBUG must be false and APP_ENV must be "production" in any deployed
# environment. Override these in that environment's own configuration —
# never change the local defaults above to do it.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Default business currency (ISO 4217) for money the app creates or shows
# without an explicit per-record currency. Presentation/default only — it
# never converts or relabels an amount that already carries its own code.
APP_DEFAULT_CURRENCY=PHP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Production hardening (Phase 11) ─────────────────────────────────
# Left blank/unset here on purpose — see docs/DEPLOYMENT.md before
# setting these in a real deployed environment.
# TRUSTED_PROXIES: comma-separated IPs/CIDRs of the reverse proxy/load
# balancer in front of the app, or "*" only when that proxy is the sole
# way to reach the app (e.g. a managed edge/LB). Required for correct
# HTTPS/client-IP detection behind any proxy — see bootstrap/app.php.
TRUSTED_PROXIES=
# How long the dedicated audit log (role/team/leadership changes —
# config/logging.php's "audit" channel) is retained, in days.
LOG_AUDIT_RETENTION_DAYS=365

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (Supabase PostgreSQL) ──────────────────────────────────
# The database of record is Supabase Postgres. Fill DB_HOST/DB_PORT/
# DB_DATABASE/DB_USERNAME/DB_PASSWORD in your local .env only, from the
# real Supabase connection details for your project. Never put real
# values here in .env.example, and never commit .env.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left unset here (session cookies not forced HTTPS-only) so local HTTP
# development keeps working. Every deployed environment (staging,
# production) MUST set this to true once served over HTTPS — see
# docs/DEPLOYMENT.md.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── AI assistant (Phase 7 / V2.0.0) ──────────────────────────────────
# LLM_PROVIDER selects the reasoning/tool-calling model provider:
#   gemini    — Google Gemini generateContent API (default)
#   anthropic — Anthropic Claude Messages API (supported fallback)
# LLM_API_KEY / LLM_MODEL belong to whichever provider is selected.
# For gemini use a Google AI Studio API key — its billing/quota is a
# Google AI Studio / Google Cloud project concern, entirely separate
# from any consumer "Gemini" app subscription. Model must support
# function calling (gemini-2.5-flash does).
# No credential here is ever exposed to the browser or logged. The
# assistant is an optional layer — the CRM stays fully functional if
# these are left blank. Gemini is ONLY the LLM; external web discovery
# stays with Brave (SEARCH_PROVIDER below). See docs/AI_ASSISTANT.md.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_MESSAGE_LENGTH=2000
AI_HISTORY_TURNS=6

# ── Agentic workflows (Phase 8) ──────────────────────────────────────
# Reuses the Phase 7 assistant above — no separate AI configuration.
# See docs/WORKFLOWS.md.
WORKFLOW_DAILY_FOLLOW_UP_REVIEW_ENABLED=true
WORKFLOW_OPPORTUNITY_ATTENTION_REVIEW_ENABLED=true
WORKFLOW_PERFORMANCE_EXCEPTION_REVIEW_ENABLED=true
WORKFLOW_RUN_AT=08:00
WORKFLOW_APPROVAL_TTL_DAYS=3
WORKFLOW_STALLED_OPPORTUNITY_DAYS=14
WORKFLOW_CLOSING_SOON_DAYS=7

# ── Business Development Intelligence (Phase 13) ────────────────────
# Deterministic thresholds for the Business Development tools/page —
# never decided by the model. Defaults are in config/services.php; set
# these only to tune. See docs/BUSINESS_DEVELOPMENT.md.
BD_STALE_LEAD_DAYS=10
BD_STALLED_OPPORTUNITY_DAYS=21
BD_RECENT_ENGAGEMENT_DAYS=7
BD_MAX_RESULTS_PER_QUERY=25
BD_HIGH_VALUE_THRESHOLD=50000

# ── V2.1: Market Intelligence — External Prospect Discovery ─────────
# External web-search provider for prospect discovery. This is a
# DEDICATED search provider and is NOT related to the LLM provider
# above — Gemini is only the reasoning model and never performs web
# search itself. Leave SEARCH_PROVIDER unset to disable discovery
# cleanly (the assistant reports "not configured"; nothing else is
# affected). For production, enable Brave:
#   SEARCH_PROVIDER=brave
#   BRAVE_SEARCH_API_KEY=<key from https://brave.com/search/api/>
#   BRAVE_SEARCH_COUNTRY=PH
# The key is never logged. See docs/MARKET_INTELLIGENCE.md.
SEARCH_PROVIDER=
SEARCH_HTTP_TIMEOUT=15
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=PH
# Bounded external effects (spec §3/§5) — tune only if needed.
MARKET_INTELLIGENCE_MAX_RESULTS=20
MARKET_INTELLIGENCE_MAX_SEARCHES=3
MARKET_INTELLIGENCE_RESULTS_PER_SEARCH=8
MARKET_INTELLIGENCE_MAX_FETCHES=12
MARKET_INTELLIGENCE_FETCH_TIMEOUT=8
MARKET_INTELLIGENCE_MAX_PER_HOUR=12
# V2.2 prospect qualification — bounded additional research per call.
MARKET_INTELLIGENCE_MAX_QUALIFY_PROSPECTS=8
MARKET_INTELLIGENCE_MAX_QUALIFY_SEARCHES=6
MARKET_INTELLIGENCE_MAX_QUALIFY_FETCHES=8
MARKET_INTELLIGENCE_MAX_QUALIFY_PER_HOUR=12
# V2.3 transparent prospect scoring. Dimension weights live in
# config/services.php (must total 100); only these are env-tunable.
MI_SCORING_VERSION=v2.3-default-1
MI_SCORING_BAND_HIGH=75
MI_SCORING_BAND_MEDIUM=50
MARKET_INTELLIGENCE_MAX_SCORE_PER_HOUR=12
# V2.4 CRM duplicate detection (narrow scoped read of `organizations`).
# Matching thresholds live in config/services.php.
MI_DUP_POLICY_VERSION=v2.4-default-1
MARKET_INTELLIGENCE_MAX_DUP_PER_HOUR=12
# V2.5 human-confirmed CRM lead creation. The AI only prepares a
# proposal; a human confirms it on the review page.
MI_LEAD_PROPOSAL_VERSION=v2.5-default-1
MARKET_INTELLIGENCE_MAX_PROPOSALS_PER_HOUR=20

# ── Gmail integration (Phase 6) ─────────────────────────────────────
# OAuth2 app credentials for the Google Cloud project registered for
# this application (Gmail API, users.messages.send scope). Per-user
# access/refresh tokens obtained via this app are stored encrypted in
# email_accounts, never here. See docs/COMMUNICATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── WhatsApp Business Platform integration (Phase 6) ────────────────
# App-wide (WABA-level) System User credentials — one set for the whole
# application, not per-number (business numbers themselves are managed
# in-app; see whatsapp_business_numbers). WHATSAPP_APP_SECRET signs
# inbound webhook payloads (X-Hub-Signature-256) and must never be
# logged or exposed. WHATSAPP_WEBHOOK_VERIFY_TOKEN is the value you
# choose and register with Meta for the webhook GET handshake.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
